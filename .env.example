CDP_PROXY_PORT=9994
CDP_PROXY_HOST=localhost
CDP_BROWSER_PORT=9222
CDP_BROWSER_HOST=localhost
CDP_PROXY_LOG_LEVEL=info

# Launch the managed browser headless (default) or headful for local debugging.
CDP_HEADLESS=true

# Default session isolation granularity: "context" (cheap) or "browser" (strict).
# "browser" gives each session its own browser process, so sites cannot be
# correlated by profile, cache, or process-level fingerprint.
CDP_ISOLATION=context

# Plugins to expose by name over the control endpoint. The standalone server
# defaults to "plugins"; embedded SDK use loads nothing unless set here.
#CDP_PLUGINS_DIRECTORY=plugins

# Trace what plugins do with each message, as `source[:methodGlob]` entries where
# source is a plugin name or "proxy" for the transport. Unset means no tracing.
#   1                     everything
#   stealth               one plugin's decisions
#   stealth:Runtime.*     ...narrowed to the methods you care about
#CDP_DEBUG=

# Front an already-running browser instead of launching one locally.
#CDP_BROWSER_WS_ENDPOINT=ws://127.0.0.1:9222/devtools/browser/<id>

# Leave unset to auto-resolve Playwright's "Chrome for Testing" build.
#
# DANGER: do NOT point this at /Applications/Google Chrome.app on a managed Mac.
# That build inherits com.google.Chrome enterprise policy, and fresh-profile
# provisioning (forced extension installs) makes Chrome detach every page target
# a few seconds after launch, which kills automation mid-run.
#CDP_BROWSER_EXECUTABLE_PATH=
