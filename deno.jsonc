{
  "name": "@zackiles/cdp-proxy-interceptor",
  "version": "0.0.1",
  "exports": "./src/mod.ts",
  "tasks": {
    "dev": "deno run --watch --allow-all ./src/main.ts"
  },
  "license": "MIT",
  "description": "A powerful Chrome DevTools Protocol (CDP) proxy interceptor that enables modifying HTTP responses with advanced features like streaming JSON parsing, UTF-8 aware text chunking, and proper escape sequence handling.",
  "runtime": {
    "deno": ">=1.37",
    "bun": ">=1.0",
    "node": ">=18.0"
  },
  "imports": {
    "@browser-tools/browser-manager": "jsr:@browser-tools/browser-manager@^0.0.12",
    "@std/assert": "jsr:@std/assert@1",
    "@std/async": "jsr:@std/async@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "@std/fs": "jsr:@std/fs@1",
    "@std/http": "jsr:@std/http@1",
    "@std/io": "jsr:@std/io@^0.225.2",
    "@std/net": "jsr:@std/net@1",
    "@std/path": "jsr:@std/path@1",
    "@zackiles/response-rewriter": "jsr:@zackiles/response-rewriter@^0.0.3",
    "chrome-launcher": "npm:chrome-launcher@1",
    "playwright": "npm:playwright@1",
    "devtools-protocol": "npm:devtools-protocol@^0.0.1422344"
  }
}
