{
  "name": "@zackiles/cdp-proxy-interceptor",
  "version": "0.0.1",
  "exports": "./src/mod.ts",
  "tasks": {
    // `--plugin <name>` opens a headful page with it installed and a pinned
    // profile; without one it runs the standalone proxy, as it always did.
    "dev": "deno run --watch --allow-all ./tools/dev.ts",
    "lint": "deno lint",
    "test": "deno test --allow-all test/**/*.test.ts",
    // The end-to-end test needs a real browser; skip it for a fast inner loop.
    "test:unit": "deno test --allow-all --ignore=test/smoke.test.ts test/**/*.test.ts",
    "smoke": "deno test --allow-all test/smoke.test.ts",
    // Record a corpus row from a real Chrome on hardware you own (§2.3).
    "capture": "deno run --allow-all ./tools/capture.ts",
    // The author's loop (§9.7): what exists, scaffold a new one, iterate on it.
    "plugins": "deno run --allow-all ./tools/plugins.ts",
    "new": "deno run --allow-all ./tools/new.ts"
  },
  "license": "MIT",
  "description": "A stealthy, plugin-configurable Playwright wrapper. Fronts Chrome's DevTools Protocol on the wire so plugins can rewrite CDP traffic per session, while callers keep using stock Playwright objects.",
  "imports": {
    "@browser-tools/browser-manager": "jsr:@browser-tools/browser-manager@0",
    "@opentelemetry/api": "npm:@opentelemetry/api@1",
    "@opentelemetry/api-logs": "npm:@opentelemetry/api-logs@0",
    "@opentelemetry/sdk-logs": "npm:@opentelemetry/sdk-logs@0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/async": "jsr:@std/async@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/dotenv": "jsr:@std/dotenv@0",
    "@std/fs": "jsr:@std/fs@1",
    "@std/http": "jsr:@std/http@1",
    "@std/io": "jsr:@std/io@1",
    "@std/jsonc": "jsr:@std/jsonc@1",
    "@std/net": "jsr:@std/net@1",
    "@std/path": "jsr:@std/path@1",
    "@zackiles/response-rewriter": "jsr:@zackiles/response-rewriter@0",
    "chrome-launcher": "npm:chrome-launcher@1",
    "playwright": "npm:playwright@1.50.1",
    "devtools-protocol": "npm:devtools-protocol@0"
  },
  "compilerOptions": {
    "strict": true,
    // The page-side helper set (§4.1), which surfaces use without importing.
    "types": [
      "./src/page.d.ts"
    ],
    "lib": [
      "deno.window",
      "deno.ns",
      // `Deno.lint`, which the page-function rule in `tools/lint.ts` is built on.
      "deno.unstable",
      "dom"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "plugins/",
      "test/",
      "tools/"
    ],
    "plugins": [
      "./tools/lint.ts"
    ]
  },
  "fmt": {
    "include": [
      "src/",
      "plugins/",
      "test/",
      "*.ts"
    ],
    "exclude": [
      "scratch/"
    ],
    "lineWidth": 80,
    "semiColons": false,
    "singleQuote": true
  }
}
